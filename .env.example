# Local development only. Never use these credentials in production.
NODE_ENV=development
POSTGRES_DB=team_knowledge_base
POSTGRES_USER=tkb
POSTGRES_PASSWORD=local_dev_only_change_me

# Host ports exposed by Docker Compose; change these if ports are already in use.
DB_HOST_PORT=5432
API_HOST_PORT=3000
WEB_HOST_PORT=8080

# Used by the API for browser-origin checks when running with Docker Compose.
WEB_ORIGIN=http://localhost:8080

# Used when running the API directly on the host (outside Docker Compose).
DATABASE_URL=postgresql://tkb:local_dev_only_change_me@localhost:5432/team_knowledge_base
DB_POOL_MAX=10
PORT=3000

# Optional Groq integration for local AI document summaries (server-side only).
# Never commit a real API key. Configure production secrets in the hosting dashboard.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# USD per one million tokens for openai/gpt-oss-120b (Groq published rates).
# Override both rates when GROQ_MODEL changes. Invalid/zero values fall back to these safe defaults.
GROQ_INPUT_COST_PER_MILLION_USD=0.15
GROQ_OUTPUT_COST_PER_MILLION_USD=0.60
# Conservative maximum estimated cost allowed for one summary request (USD).
GROQ_MAX_REQUEST_COST_USD=0.01
